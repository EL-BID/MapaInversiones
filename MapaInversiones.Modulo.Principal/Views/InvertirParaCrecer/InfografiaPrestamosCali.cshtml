                                    <div class="row">
                                        <div class="col-lg-4">
                                            <div class="wrap-content">
                                                <span class="label text-bold">Banco que presta</span>
                                                <div class="wrap-img">
                                                    <img class="img-fluid" src="@item.IconoEntidadFinanciera" onerror="this.src='img/logo-banco-default.png'" alt="logo entidad bancaria" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-8">
                                            <div class="monto h4"><span class="label">Monto <br /></span>@Html.FormatoMoneda(item.Monto, decimales: 0, nivel: 1)</div>
                                            <!--
                                            <div class="wrap-desc-entidad">
                                                <div class="execute">Porcentaje comprometido en contratos</div>
                                                <div class="progress position-relative">
                                                    <div class="progress-bar" aria-label="Porcentaje comprometido en contratos" role="progressbar"
                                                         style="width:@(item.PorcentajeEjecucion.ToString("F1", CultureInfo.InvariantCulture))%"
                                                         aria-valuenow="@item.PorcentajeEjecucion" aria-valuemin="0" aria-valuemax="100">
                                                        @if (item.PorcentajeEjecucion >= 10)
                                                        {
                                                            <span class="lblporc">@Html.FormatoNumero(item.PorcentajeEjecucion) %</span>
                                                        }
                                                    </div>
                                                    @if (item.PorcentajeEjecucion < 10)
                                                    {
                                                        <span class="lblporc-small position-absolute" style="left: calc(@(item.PorcentajeEjecucion.ToString("F1", CultureInfo.InvariantCulture))% + 8px); top: 50%; transform: translateY(-50%); color: #666; font-size: 0.85em; white-space: nowrap; font-weight: bold !important;">
                                                            @Html.FormatoNumero(item.PorcentajeEjecucion) %
                                                        </span>
                                                    }
                                                </div>

                                            </div>
                                            -->
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-lg-4">
                                            <div class="monto"><span class="label">Plazo</span><br /> @($"{item.Plazo}")</div>
                                            <div class="monto"><span class="label">Período de gracia</span><br />@($"{item.PeriodoGracia}")</div>
                                        </div>
                                        <div class="col-lg-5">
                                            <div class="monto"><span class="label">Fecha del contrato</span><br />@($"{item.FechaContrato}")</div>
                                            <div class="monto"><span class="label">Proyectos que financia:</span><br />@Html.FormatoNumero(item.NumeroProyectos,decimales:0)</div>
                                        </div>
                                        <div class="col-lg-3">
                                            <div class="monto"><span class="label">Tasa de interés</span><br /> @item.TasaInteres</div>

                                        </div>
                                        <!-- <div class="col-12">
                                            <div class="card p-3 my-3">
                                                <p class="small m-0">
                                                    La barra de porcentaje comprometido aumenta a medida que se firman los contratos para ejecutar los proyectos financiados con cada crédito.
                                                </p>
                                            </div>
                                        </div>-->
                                    </div>
                                    <div class="wrap-btn">
                                        <a href="/PerfilPrestamo?id=@($"{item.IdEntidadFinanciera}")" target="_blank" class="btn btn-primary btn-sm">
                                            <span>Proyectos</span>
                                            <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                                                <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                                            </svg>
                                        </a>
                                        <a href="@($"{item.UrlContrato}")" target="_blank" class="btn btn-outlined">
                                            <span>Contrato de crédito</span>
                                            <i class="material-icons md-24">open_in_new</i>
                                        </a>
                                    </div>

                                </div>
                            </li>


                        }
                        
                       

                    </ul>


                </div>
            </div>
            
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="disclaimer highlightedMSG px-3">
                            <div class="wrap-text">
                            <div class="wrap-img"><img src="img/ic-alcaldia-aaa.svg" alt="icono de calificacion triple A"/></div>
                            <p><span class=" text-bold">La Alcaldía de Cali cuenta con la calificación AAA de Fitch Ratings, que ratifica su solidez financiera y el adecuado manejo de las finanzas.</span> Por eso podemos acceder a créditos de esta magnitud</p>
                        </div>
                        </div>
                    </div>
                </div>
        </div>
