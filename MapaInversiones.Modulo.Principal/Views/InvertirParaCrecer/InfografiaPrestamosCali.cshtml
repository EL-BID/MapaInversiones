    <!--slider MAPA-->
    <section class="section" id="s1">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="section-heading heading-center">
                        <h2>¿En qué se está invirtiendo la plata?</h2>
                    </div>
                    <div class="sub-heading text-center mb-3">
                        <!--<p>Estamos construyendo la ciudad que soñamos con resultados tangibles. Acá te contamos cómo invertimos los primeros $1.4 billones para recuperar a Cali y proyectarla al futuro.</p>-->
                        <p class="text-bold">
                            En esta infografía te resumimos los proyectos que se están desarrollando con recursos del crédito público. <br />¡Así recuperamos Cali!
                        </p>
                    </div>
                    

                </div>
            </div>

        <div class="bg-gradient-slider px-5">
            <div class="wrap-slider-ipc py-3">
                    <div class="carousel carousel-nav" data-flickity='{ "asNavFor": ".carousel-ipc", "contain": true, "freeScroll": true, "prevNextButtons": false, "pageDots": false  }'>
                        @{
                            
                            var list = await Orchard.GetContentItemByHandleAsync("alias:bannerhome");
                            var items = ((IEnumerable<dynamic>)list.Content.BagPart.ContentItems)
                            .OrderBy(x => (int?)(x.Banner?.orden?.Value) ?? 0)
                            .ToList();
                        }
                        @foreach (var item in items)
                        {
                            var titulo = (string)(item.Banner?.Titulo?.Text ?? "");
                            var icono = (string)(item.Banner?.Icono?.Paths?.Count > 0
                            ? item.Banner.Icono.Paths[0]
                            : null ?? "");

                            <div class="carousel-cell">
                                <div class="wrap-icon">
                                    <img class="img-fluid" src="@Orchard.AssetUrl((string)icono)" alt="icono decorativo de obras" />
                                </div>
                                <div class="tit-slide">@titulo</div>
                            </div>
                        }
                    </div>
                    <div class="carousel carousel-ipc" data-flickity='{ "fullscreen": true }'>
                        @foreach (var item in items)
                        {
                            var ruta = (string)(item.Banner?.Fondo?.Paths?.Count > 0
                            ? item.Banner.Fondo.Paths[0]
                            : null ?? "");
                            
                            <div class="carousel-cell">
                                <img class="img-fluid"
                                     src="@Orchard.AssetUrl((string)ruta)"
                                     alt="Listado de obras" />
                            </div>
                        }

                    </div>
            </div>


        </div>
       
         <!--FIN FECHA CORTE INFORMACION-->
        </div>
    </section>
