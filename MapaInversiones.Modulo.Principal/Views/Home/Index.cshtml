@inject OrchardCore.IOrchardHelper Orchard
@model PlataformaTransparencia.Modelos.ModelHomeData
@using PlataformaTransparencia.Modulo.Principal.Helpers

@{
    System.Globalization.CultureInfo cultureInfo = new System.Globalization.CultureInfo("es-CO");
}

@{


    var banners = await Orchard.GetContentItemByHandleAsync("alias:bannerhome");
    var content_media = await Orchard.GetContentItemByHandleAsync("alias:VideoHome");
    var url_aux = Convert.ToString(content_media?.Content?.BannerMedia?.src?.Url);


    var maxAnyo = @Model.MaxAnnioEntidades;
    var anteriorVigencia = @Model.anteriorVigencia;
    var flag_vigencia_anterior = Model?.anteriorVigencia != null;
    var flag_vigencia_actual = Model?.InfoVigenciaActual != null;
    var vigente_actual = @Html.FormatoMoneda(Model?.InfoVigenciaActual?.Presupuesto != null ? Model.InfoVigenciaActual.Presupuesto : 0,decimales:2);
    var porc_actual = Model.InfoVigenciaActual.Presupuesto > 0 ? String.Format("{0:n0}", (Model.InfoVigenciaActual.Ejecutado / Model.InfoVigenciaActual.Presupuesto) * 100) : "0";

    //var val_giros = @Html.FormatoMoneda(Model?.InfoVigenciaActual?.valorGiros != null ? Model.InfoVigenciaActual.valorGiros : 0);
    //var val_comprometido = @Html.FormatoMoneda(Model?.InfoVigenciaActual?.valorComprometido != null ? Model.InfoVigenciaActual.valorComprometido : 0);


}
<style>
    .capitalEntidad {
    text-transform: capitalize;
    }

    .autocomplete-suggestions {
    border: 1px solid #999;
    background: #FFF;
    overflow: auto;
    }

    .autocomplete-suggestion {
    padding: 2px 5px;
    white-space: nowrap;
    overflow: hidden;
    }

    .autocomplete-selected {
    background: #F0F0F0;
    }

    .autocomplete-suggestions strong {
    font-weight: normal;
    color: #3399FF;
    }

    .autocomplete-group {
    padding: 2px 5px;
    }

    .autocomplete-group strong {
    display: block;
    border-bottom: 1px solid #000;
    }

    path:hover {
    fill: #5916c3;
    stroke: #5916c3;
    stroke-width: 3px;
    transition: fill 0.4s;
    color:#fff;
    }

    /* Estilos específicos para la gráfica */
    .bubble-chart-container {
    width: 100%;
    height: auto;
    position: relative;
    }

    .bubble-chart-svg {
    width: 100%;
    height: auto;
    }

    .bubble-chart-bubble {
    stroke: #fff;
    stroke-width: 1px;
    stroke-linejoin: round;
    transition: transform 0.2s ease, stroke-width 0.2s ease, stroke 0.2s ease;
    }

    .bubble-chart-text {
    font-family: inherit;
    fill: #fff;
    font-weight: bold;
    pointer-events: none;
    text-anchor: middle;
    }

    .bubble-chart-tooltip {
    position: absolute;
    text-align: center;
    padding: 10px;
    font-family: inherit;
    font-size: clamp(10px, 1vw, 12px);
    background: #dcdcdc;
    color: #000;
    border-radius: 10px;
    pointer-events: none;
    visibility: hidden;
    box-shadow: 0px 6px 20px rgba(0, 0, 0, 0.25);
    z-index: 10;
    min-width: 100px;
    max-width: 200px;
    word-wrap: break-word;
    }
</style>

<main>

    <!-- MAIN SLIDER SECTION -->
    <input id="anioPresupuesto" value="@maxAnyo" hidden />
    <input id="anteriorVigencia" value="@anteriorVigencia" hidden />
    <section class="section main-slider" id="ContenedorVigencia">
        @if (flag_vigencia_actual)
        {
            <div class="container">
                <div class="row wrap-header-tit justify-content-center">

                    <div class="col-lg-10 Tagline">
                        <h2 class="d-none">¿En qué invierte la Alcaldía de Bucaramanga en @maxAnyo ?</h2>
                        <h1>Así se usan los recursos públicos en Bucaramanga</h1>
                    </div>
                    <div class="col-lg-10 text-center">
                        <p class="section-subheading p-0">
                            Accede a información clara y abierta sobre presupuesto, entidades, contratos y proyectos que se adelantan en la ‘Ciudad Bonita’.
                        </p>

                    </div>

                </div>


            </div>
            <div class="container-fluid">
                <!-- MAIN SLIDESHOW-->
                <div class="slide-vertical-thumb">
                    <div class="row">
                        <div class="col-sm-12 col-md-12 col-xl-3 col-lg-3 col-xxl-3 thumb-left">
                            <div class="carousel carousel-nav " data-flickity='{"asNavFor": ".carousel-mainX", "draggable": false, "percentPosition": false, "groupCells": "100%", "pageDots": false, "prevNextButtons": false }'>
                                <div class="carousel-cell"> <div>¿Cuánto es el presupuesto disponible?</div></div>
                                <div class="carousel-cell"> <div>¿En qué se invierte el dinero?</div></div>
                                <div class="carousel-cell"><div> ¿Quién invierte?</div></div>

                            </div>
                        </div>
                        <div class="col-sm-12 col-md-12 col-xl-9 col-lg-9 col-xxl-9 slide-horizontal">
                            <div class="carousel carousel-mainX" data-flickity='{ "contain": true, "pageDots": false, "autoPlay": 9000, "adaptiveHeight": "true", "groupCells": true }'>
                                <div class="carousel-cell">
                                    <div class="wrap-cell-container">
                                        <div class="row align-items-center">
                                            <div class="col-lg-12"><h3 class="py-3">¿Cuánto es el presupuesto disponible en @maxAnyo?</h3></div>
                                            <div class="col-md-6 col-lg-5 h-100 text-center">
                                                <img src="https://placehold.co/400x400.jpg" class="img-fluid" alt="dummy image" />
                                                <small>Image/SVG graphic container</small>
                                            </div>
                                            <div class="col-sm-12 col-md-6 col-lg-7 h-100">
                                                <div class="wrap-main-datos">
                                                    <div class="wrap-summary">
                                                        <span class="big-number">$ @vigente_actual</span>
                                                        <small>Presupuesto total vigente</small>
                                                    </div>
                                                    @* <div class="wrap-summary">
                                                        <span class="big-number">$ @AprobadoFondo billones</span>
                                                        <small>Recursos Propios</small>
                                                    </div> *@

                                                    <div class="wrap-summary">
                                                        <span class="big-number">@porc_actual %</span>
                                                        <small>Ejecutado</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>


                                    </div>

                                </div>
                                <div class="carousel-cell">
                                    <div class="wrap-cell-container">
                                        <div class="row align-items-center">
                                            <div class="col-lg-12">
                                                <h3>¿En qué se invierte el dinero?</h3>

                                                <p>Pellentesque odio ante, accumsan id blandit quis, commodo vitae metus. Donec et pretium arcu, et varius arcu. </p>

                                            </div>
                                            <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-5 h-100" style="text-align:left;"> <div id="divEnQueInvirtieron" style="z-index:1000000;width:100%;height:auto;"></div></div>
                                            <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-7  h-100">

                                                <div class="wrap">
                                                    <p class="text-bold"><span class="text-bold">SECTORES</span> con mayor asignación presupuestal para inversión durante @maxAnyo:</p>
                                                    <div class="row" id="cardEnQueInvirtieron"> </div>
                                                </div>
                                                <div class="wrap-cta my-3">
                                                    <a href="/BusquedaResultados?Type=Sector" class="btn btn-primary btn-lg">
                                                        <span title="Ver más">Ver todos los sectores </span>

                                                        <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                                                            <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                                                        </svg>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>


                                    </div>

                                </div>
                                <div class="carousel-cell">
                                    <div class="wrap-cell-container">
                                        <div class="row align-items-center">
                                            <div class="col-lg-12">
                                                <h3>¿Quién invierte?</h3>
                                                <p>Pellentesque odio ante, accumsan id blandit quis, commodo vitae metus. Donec et pretium arcu, et varius arcu. </p>
                                            </div>
                                            <div class="col-md-6 col-lg-6  col-xl-6 col-xxl-5 h-100"> 
                                                <div id="divQuienInvirtio" class="bubble-chart-container" style="z-index: 1000000;"></div>
                                            </div>

                                            <div class="col-md-6 col-lg-6 col-xl-6 col-xxl-7 h-100">

                                                <div class="wrap">
                                                    <p class="text-bold"><span class="text-bold">ENTIDADES</span> con mayor ejecución presupuestal durante el @maxAnyo</p>
                                                    <div class="row" id="cardQuienInvirtio">
                                                    </div>
                                                </div>
                                                <div class="wrap-cta my-3">
                                                    <a href="/BusquedaResultados?Type=Ente" class="btn btn-primary btn-lg">
                                                        <span title="Ver más">Ver entidades </span>

                                                        <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                                                            <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                                                        </svg>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>


                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        
        
        }
        
    </section>


    <!-- COMO VA LA EJECUCIóN 2025 -->
    
    
    <section class="section wrap-instituciones soft-gradient">
        <div class="container">
            <div class="row align-items-center justify-content-center mb-4" id="divVigenciaActual">
                <div class="section-heading heading-center py-4">
                    <h2>¿Cómo va la ejecución del presupuesto en <span class="anio">@maxAnyo?</span></h2>
                </div>
                <div class="col-lg-12">
                    <div class="wrap-icon text-center">
                        <img class="img-fluid" src="img/icon-budget.svg" alt="icono decorativo" />
                    </div>
                    <div class="wrap-summary mb-4">
                        <span class="h5">Recursos disponibles</span>
                        <span class="big-number">$ @vigente_actual</span>
                        
                    </div>

                </div>
                <div class="col-lg-8">
                    <div class="wrap-summary mb-4">
                        <span class="h5">Ejecutado con fecha de corte: @Model.fechasCorte.fechaCorte</span>
                        <div class="progesscontainer pgreen">
                            <div class="progress" style="height:65px;">
                                <div class="bg-proexec" role="progressbar"
                                     style='@($"width:{porc_actual}%")'
                                     aria-valuenow='@(porc_actual)'
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    @(porc_actual)%
                                </div>
                            </div>
                        </div>

                    </div>
                    
                </div>
                <div class="sep-H-shadow"></div>
            </div>
            <!-- INSTITUCIONES -->
            <div class="row py-4">
                <div class="col-12">
                    <div class="section-heading heading-center py-4">
                        <h2>¿Cuánto presupuesto ejecutan secretarías, departamentos y unidades de la Alcaldía durante el <span class="anio">@maxAnyo?</span></h2>
                        <div class="section-subheading">
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div id="divContenedorFichas22" class="project-carusel" data-flickity='{ "imagesLoaded": true, "pageDots": false, "lazyLoad": true, "lazyLoad": 10, "groupCells": true, "contain": true, "prevNextButtons": true, "autoPlay": 8000 }'>
                        @if (Model.Entidades != null)
                        {
                            @foreach (var item in Model.Entidades)
                            {
                                
                                var anyo = @Model.MaxAnnioEntidades;
                                var href_aux = "/perfilEntidad?codEntidad=" + item.id;

                                var porcentaje = item.avance > 0
                                ? Math.Round((item.avance / item.asignado) * 100, 2)
                                : 0;

                                // Para MOSTRAR al usuario (con coma)
                                var porcentajeStr = porcentaje.ToString("0.##", cultureInfo) + "%";

                                // Para CSS (con punto - InvariantCulture)
                                var porcentajeVal = porcentaje.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

                                <text>
                                    <div class="col-lg-3 mb-3">
                                        <div class="card h-100 shadow border-0 card-entidad">
                                            <a href=@href_aux>
                                                <div class="card-body">
                                                    <div class="card-title-container mh56">
                                                        <span class="h5" id="@item.id">@item.labelGroup</span>
                                                    </div>
                                                    <div class="wrap-desc-entidad">
                                                        <div class="execute">Valor total ejecutado</div>
                                                        <div class="progress">
                                                            <div class="progress-bar"
                                                                 aria-label="Porcentaje Ejecutado"
                                                                 role="progressbar"
                                                                 style="width:@porcentajeVal%"
                                                                 aria-valuenow="@porcentajeVal"
                                                                 aria-valuemin="0"
                                                                 aria-valuemax="100">
                                                                <span class="lblporc">@porcentajeStr</span>
                                                            </div>
                                                           
                                                        </div>
                                                        <div class="wrap-data-advance py-3">
                                                            <span class="executeN">  $ @Html.FormatoMonedaDecimal(@item.avance,0)</span>
                                                             
                                                        </div>
                                                        


                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </text>
                            }
                        }
                    </div>
                </div>

            </div>
            <div class="section-btns justify-content-center py-3">
                <a title="Ver todas las entidades" href="/BusquedaResultados?Type=Ente" class="btn btn-primary">
                    <span>Ver todas las entidades</span>
                    <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                        <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                    </svg>
                </a>
            </div>
        </div>
    </section>
    <!-- MAPA COMUNAS Y CORREGIMIENTOS -->
    <section class="section provincias pb-0">
        <div class="container-fluid">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-8">
                    <div class="section-heading heading-center">
                        <h2>¿Qué proyectos hay en tu zona?</h2>
                        <p class="section-subheading">Aquí podrás conocer los proyectos que la Alcaldía de Bucaramanga está ejecutando en tu comuna. Encontrarás información sobre las obras y programas en curso, su estado de avance, los recursos invertidos y los beneficios que traerán para la comunidad.  </p>

                    </div>
                    <div class="wrap-counter d-flex">
                        <div class="counters">
                            <div class="desc-data">
                                <div class="executeV">Proyectos en ejecución</div>
                                <div class="executeN" id="numProyExe">@String.Format(cultureInfo, "{0:n0}", Model.countOngoingProjects.cantidad)</div>
                            </div>
                        </div>
                        <div class="counters">
                            <div class="desc-data">
                                <div class="executeV">Costo total de proyectos en ejecución</div>
                                <div class="executeN" id="costoProyExce">$ @String.Format(cultureInfo, "{0:n0}", Model.countOngoingProjects.costo / 1000000) millones</div>
                            </div>
                        </div>
                    </div>


                </div>


            </div>
            <div class="row location-tabs">
                <!--COMUNAS-->
                <div class="location-card mb-4">
                    <h3 class="text-center">Comunas</h3>
                    <div class="carousel" data-flickity='{ "contain": true, "pageDots": true, "autoPlay": 9000, "cellAlign": "right", "groupCells": true }'>
                        @foreach (var item in Model.Comunas)
                        {
                            <div class="carousel-cell">
                                <div class="card comuna" style="background-image:url(@Url.Content($"../img/{item.UrlImg}"))">
                                    <div class="card-body">
                                        <a href="@item.LinkLocationProfile" class="h4">@item.Nombre</a>
                                        <span class="number-proyecto">(@item.CantidadProyectos proyectos)</span>
                                    </div>
                                </div>
                            </div>
                        }
                                       
                    </div>
                </div>

            </div>
            <!--tabs-->
            <div class="row d-none">


                <div class="tabs location-tabs">
                    <ul class="tabs-nav">
                        <li class="active">Comunas</li>
                        <li class="">Corregimientos</li>

                    </ul>
                    <div class="tabs-container">
                        <div class="tabs-item location-card content active">
                        </div>
                        <!--tabs corregimiento-->
                        <div class="tabs-item location-card content">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="section map-link">
            <div class="container">
                <div class="row justify-content-end">
                    <div class="col-lg-5">
                        <div class="section-heading heading-left">
                            <h2>Explora el Mapa de Proyectos</h2>
                            <div class="section-subheading">
                                El Mapa de Proyectos es una herramienta digital que te permite conocer, de manera sencilla y transparente, en qué se están invirtiendo los recursos públicos de Bucaramanga. 
                            </div>
                            <p>A través de este mapa puedes ubicar las obras, programas y acciones que la Alcaldía desarrolla en cada zona del municipio, conocer su estado de avance, los montos invertidos y las entidades responsables.</p>
                        </div>
                        <div class="wrap-cta my-3 text-left">
                            <a href="/MapView" class="btn btn-primary btn-lg">
                                <span title="Ver más">Ver Mapa </span>

                                <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                                    <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                                </svg>
                            </a>
                        </div>
                    </div>

                </div>



            </div>


        </div>
    </section>



    <!-- HERRAMIENTAS DE CONTROL CIUDADANO -->
    <section class="section section-graysoft d-none">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-10 col-xl-6">
                    <div class="section-heading heading-left py-4">
                        <h2 class="">‘¡Pa’ que hagás parte!</h2>

                    </div>
                    <div class="section-subheading">
                        <p><span class="text-bold">¿Tenés una empresa y te gustaría contratar con la Alcaldía? ¿Te apasiona el control social y querés saber cómo se invierte cada peso?</span> ¡Pa’ que Veás! que la contratación está al alcance de todos y todas, te presentamos las herramientas, servicios de apoyo y recursos educativos para que conozcás cómo avanza la contratación de la Alcaldía y podás participar. </p>
                        <p>Pellentesque odio ante, accumsan id blandit quis, commodo vitae metus. Donec et pretium arcu, et varius arcu. </p>
                    </div>

                </div>
                <div class="col-lg-10 col-xl-6">
                    <div class="cards-grid">
                        <div class="card h-100 shadow border-0 b1">
                            <div class="card-body">
                                <div class="wrap-desc-entidad">
                                    <div class="wrap-icon"><img src="../img/ic-ut1.svg" alt="icono decorativo relacionado a proveedores" /></div>
                                    <div class="h3">Soy empresario/a</div>
                                    <p>Sos una persona natural o jurídica constituida legalmente que ofrece bienes o servicios y estás interesado/a en convertirte en proveedor de la Alcaldía Distrital de Santiago de Cali.</p>
                                    <a class="btn enlace_monitoreo" parametro="1">
                                        <span class="material-icons md-24">arrow_forward</span>
                                    </a>
                                </div>

                            </div>
                        </div>
                        <div class="card h-100 shadow border-0 b2">
                            <div class="card-body">
                                <div class="wrap-desc-entidad">
                                    <div class="wrap-icon"><img src="../img/ic-ut2.svg" alt="icono decorativo relacionado a veedores" /></div>
                                    <div class="h3">Soy veedor/a</div>
                                    <p>Si te apasiona el control social de los recursos y querés saber en qué se invierte cada peso, este es tu lugar. Con tu ayuda recuperamos a Cali.</p>
                                    <a class="btn enlace_monitoreo" parametro="2">
                                        <span class="material-icons md-24">arrow_forward</span>
                                    </a>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- NEWS AND SOCIAL MEDIA-->
    <section class="section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="Cnews">
                        <div class="section-heading heading-left">
                            <a href="https://www.cali.gov.co/publicaciones/noticias/?tema=2" target="_blank">
                                <h2>¡Actualízate!</h2>
                            </a>
                            <div class="section-subheading">
                                Conozca las últimas noticias sobre la ejecución de los proyectos en Bucaramanga.
                            </div>
                        </div>
                        <div class="cards-News-container">
                            <div class="row">
                            @foreach (var noticia in await Orchard.GetRecentContentItemsByContentTypeAsync("BlogPost", 4))
                            {

                                <!--NOTICIA 3-->
                                <div class="col-lg-4">
                                <div class="card mb-3">
                                    <div class="row g-0">
                                        <div class="col-12">
                                            @{
                                                var imgpath = "img/Pic001.jpg";
                                                if (noticia.Content.BlogPost.BannerImage.Paths.Count != 0)
                                                {
                                                    imgpath = noticia.Content.BlogPost.BannerImage.Paths[0];
                                                    <img class="img-fluid" src=@Orchard.AssetUrl((string)imgpath) alt="...">
                                                }
                                                else
                                                {
                                                    <img class="img-fluid" src=@imgpath alt="...">
                                                }
                                            }

                                        </div>
                                        <div class="col-12">
                                            <div class="card-body Noticia">
                                                <a href="/Noticia/@noticia.ContentItemId"><span class="h4">@noticia</span></a>
                                                <p class="card-text">@noticia.Content.BlogPost.Subtitle.Text</p>
                                                <!--<p class="card-text"><small class="text-muted">Creado: @noticia.CreatedUtc</small></p>-->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            }
                            </div>
                        </div>
                    </div>
                    <div class="section-btns justify-content-center py-3">
                        <a title="Leer más noticias" href="https://www.bucaramanga.gov.co/noticias/" class="btn btn-primary" target="_blank">
                            <span>Leer más noticias</span>
                            <svg class="btn-icon-right" viewBox="0 0 13 9" width="13" height="9">
                                <use xlink:href="../../../img/sprite.svg#arrow-right"></use>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--CONTACT US-->
    <!--HELP CENTER SHORTCUT-->
    <div id="helpCenter"></div>


</main>
@section scripts
{
    <script type="text/javascript" src="~/js/lib/d3/d3.v7.min.js"></script>
    <script type="text/javascript" src="~/js/search_aux.js"></script>
    <script type="text/javascript" src="~/js/lib/d3/d3plus@2.js"></script>
    <script src="~/js/scripts.js"></script>
    <script src="~/js/home_aux.js"></script>
}
