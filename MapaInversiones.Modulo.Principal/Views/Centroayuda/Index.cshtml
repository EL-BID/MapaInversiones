@page
@using Newtonsoft.Json.Linq
@inject OrchardCore.IOrchardHelper Orchard
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayglosario = "";
    var displaypreguntas = "";
    var displaytabglosario = "";
    var displaytabpreguntas = "";
     if (ViewBag.tab == 2 )
    {
        displayglosario = "display:none"; displaytabglosario = "btn-section ";
        displaypreguntas = "display:block"; displaytabpreguntas = "btn-section focused-btn";
    }
    else
    {
        displayglosario = "display:block"; displaytabglosario = "btn-section focused-btn";
        displaypreguntas = "display:none"; displaytabpreguntas = "btn-section";
    }

            }

<!--MAIN BANNER-->
<section class="banner-main mb-0">

    <div class="container">
        <!-- Begin bread crumbs -->
        <nav class="bread-crumbs">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <ul class="bread-crumbs-list">
                            <li>
                                <a href="/">Inicio</a>
                                <i class="material-icons md-18">chevron_right</i>
                            </li>
                            <li>Resolvé tus dudas</li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav><!-- End bread crumbs -->


        <div class="row justify-content-center">

            <div class="col-lg-8">
                <div class="banner-main-info pb-0">
                    <div class="banner-main-title py-4">
                        <h1>Resolvé tus dudas</h1>
                    </div>
                    <div class="banner-main-desc">
                        <!--<p>Lorem ipsum dolor sit amet consectetur adipiscing elit, rutrum vulputate fermentum ullamcorper litora vel, suspendisse ac consequat rhoncus lectus ligula.</p>-->

                    </div>

                </div>

            </div>

        </div>
    </div>

</section>
<div class="subMenuGlosario">
    <div class="container">
        <div class="row navs-shortcuts justify-content-center m-0">
            <div class="navHdisplay" id="navs-header">
               
                    <a class="@displaytabglosario" id="glosario" style="display: inline;" href="#!">
                        <img src="img/ic-hc1.svg" alt="icono decorativo" /> <span>Glosario</span>
                    </a>
                    <a class="@displaytabpreguntas" id="preguntas" style="display: inline;" href="#!">
                        <img src="img/ic-hc2.svg" alt="icono decorativo" /><span>Preguntas Frecuentes</span>
                    </a>
                <a class="" id="guias" style="display: inline;" href="#nav-guides">
                        <img src="img/ic-hc3.svg" alt="icono decorativo" /><span>Guías de Navegación</span>
                    </a>
      
            </div>
        </div>
    </div>
</div>
<!--main content-->
<section class="">
    <div class="container">

        <!--GLOSARIO-->
        <div class="sect-tab glosario" id="glosario" style="@displayglosario" >
            <div class="row">
                <div class="col-lg-2">
                </div>
                <div class="col-lg-8">
                    <div class="wrap-letters">
                        @for (char c = 'A'; c <= 'Z'; c++)
                        {
                            <div class="indice" id="@c">
                                @c
                            </div>}
                    </div>
                </div>
            </div>
            <div class="row">
                @{ var glosario = await Orchard.GetContentItemByHandleAsync("alias:PalabrasGlosario"); }
                <!--LEFT COLUMN-->
                <div class="col-lg-2">
                </div>
                <!--RIGHT COLUMN-->
                <div class="col-lg-8">
                    @foreach (var palabra in glosario.Content.BagPart.ContentItems)
                    {
        string p = @palabra.DisplayText.ToString().Substring(0, 1);
                        <div class="palabra @p" id="">
                            <br />
                            <span class="h4">
                                <strong>@palabra.DisplayText</strong>
                            </span>
                            <div>@Html.Raw(palabra.HtmlBodyPart.Html)</div>

                        </div>}


                </div>
            </div>
        </div>

        <!--FAQ-->
        <div class="sect-tab preguntas" id="preguntas" style="@displaypreguntas">
            <div class="row">
                @{ var preguntas = await Orchard.GetContentItemByHandleAsync("alias:Preguntas");
                List<string> categorias = new List<string>(); }
                <!--LEFT COLUMN-->
                <div class="col-lg-3">
                    @foreach (var pregunta in preguntas.Content.BagPart.ContentItems)
                    {
                        @foreach (var termId in pregunta.Pregunta.Categoria.TermContentItemIds)
                        {
                            string term = termId + "";
                            string taxonomy = pregunta.Pregunta.Categoria.TaxonomyContentItemId + "";
                            var categoryTerm = await Orchard.GetTaxonomyTermAsync(taxonomy, term);
                            var display = categoryTerm.DisplayText;

                            if (!categorias.Contains(term))
                            {
                                categorias.Add(term);
                                
                                var content = (JObject)categoryTerm.Content;

                                string aliasText =
                                (string)content["Categoria"]?["Alias"]?["Text"] // tu campo Alias
                                ?? (string)content["AutoroutePart"]?["Path"]     // fallback al slug
                                ?? "";

                                <div class="categoriapregunta"
                                     data-alias="@aliasText"
                                     data-debug-display="@display">
                                    <span class="h5">@display</span>
                                </div>                               

                               
                            }
                        }
                    }
                    
                </div>
                <!--RIGHT COLUMN-->
                <div class="col-lg-8">
                    @foreach (var pregunta in preguntas.Content.BagPart.ContentItems)
                    {
                        @foreach (var termId in pregunta.Pregunta.Categoria.TermContentItemIds)
                        {
                            string term = termId + "";
                            string taxonomy = pregunta.Pregunta.Categoria.TaxonomyContentItemId + "";
                            var categoryTerm = await Orchard.GetTaxonomyTermAsync(taxonomy, term);

                            var content = (JObject)categoryTerm.Content;

                            string aliasText =
                            (string)content["Categoria"]?["Alias"]?["Text"] // tu campo Alias
                            ?? (string)content["AutoroutePart"]?["Path"]     // fallback al slug
                            ?? "";

                            <div class="pregunta @aliasText">
                                <span class="h4"><strong>@pregunta.DisplayText</strong></span>
                                <div>@Html.Raw(pregunta.HtmlBodyPart.Html)</div>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>


    </div>
</section>
<section class="section" id="nav-guides">
    <div class="container">
        <div class="section-heading heading-left py-4">
            <h2 class="">Guías de Navegación</h2>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <h3 class="h4">¿Cómo usar el mapa de georreferenciación de ¡Pa' que Veás!?</h3>
                <div class="ratio ratio-16x9">
                    <iframe width="560" height="315" src="https://www.youtube.com/embed/Vr-IipAyT14?si=hHh6S3A456TLzePH" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
            </div>
            <div class="col-lg-6">
                <h3 class="h4">¿Cómo buscar los proyectos en tu comuna o corregimiento con ¡Pa' que Veás!?</h3>
                <div class="ratio ratio-16x9">
                    <iframe width="560" height="315" src="https://www.youtube.com/embed/BiW9jlOpcbM?si=EHSlp0IR2bheYAyl" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
  $(document).ready(function () {

    var enlacePregunta = document.getElementById("preguntas");
    if (enlacePregunta && enlacePregunta.style.display != "none") {
      // Mostrar preguntas de la primera categoría
      var c = document.getElementsByClassName("categoriapregunta");
      if (c.length) {
        var alias0 = (c[0].dataset.alias || '').toLowerCase();
        Mostrar("pregunta", "pregunta " + alias0);
        c[0].className = "categoriapregunta focused-cat";
      }

      // Glosario: primera letra
      Mostrar("palabra", "palabra A");
      var g = document.getElementById('A');
      if (g) g.className = "indice focused-glo";
    }
    else {
      Mostrar("sect-tab", "sect-tab contacto");
    }

    $('.section-question').hide();

    // ---------------- MODIFICACIÓN: abrir por ?section= ----------------
    const urlParams = new URLSearchParams(window.location.search);
    const section = (urlParams.get('section') || '').trim().toLowerCase();

    if (section) {
      setTimeout(() => {
        if (enlacePregunta) $(enlacePregunta).trigger('click');

        //categoria por data-alias
        const sel = `.categoriapregunta[data-alias="${section}"]`;
        const menuItem = document.querySelector(sel);

        if (menuItem) {
          const alias = (menuItem.dataset.alias || '').toLowerCase();

          //ver preguntas
          $(menuItem).trigger('click');
          Mostrar('pregunta', 'pregunta ' + alias);

          // Estilos
          document.querySelectorAll('.categoriapregunta')
            .forEach(el => el.className = 'categoriapregunta');
          menuItem.className = 'categoriapregunta focused-cat';
        } else {
          console.warn('Categoría no encontrada:', section);
        }
      }, 0);
    }
    // ---------------- FIN MODIFICACIÓN ----------------
  });

  // Click en categoría x data-alias
  $(document).on('click', '.categoriapregunta', function () {
    var alias = (this.dataset.alias || '').toLowerCase();
    Mostrar('pregunta', 'pregunta ' + alias);

    var y = document.getElementsByClassName('categoriapregunta');
    for (var i = 0; i < y.length; i++) y[i].className = "categoriapregunta";
    this.className = "categoriapregunta focused-cat";
  });

  // Click en botones de sección
  $(document).on('click', '.btn-section', function () {
    var id = "sect-tab " + this.id;
    Mostrar('sect-tab', id);
    var y = document.getElementsByClassName('btn-section');
    for (var i = 0; i < y.length; i++) y[i].className = "btn-section";
    this.className = "btn-section focused-btn";
  });

  // Click en índice del glosario
  $(document).on('click', '.indice', function () {
    var id = "palabra " + this.id;
    Mostrar('palabra', id);
    var y = document.getElementsByClassName('indice');
    for (var i = 0; i < y.length; i++) y[i].className = "indice";
    this.className = "indice focused-glo";
  });

   function Mostrar(ocultar, mostrar) {
    
    var y = document.getElementsByClassName(ocultar);
    for (var i = 0; i < y.length; i++) y[i].style.display = "none";

    var x = document.getElementsByClassName(mostrar);
    for (var j = 0; j < x.length; j++) x[j].style.display = "block";
  }
</script>

