@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Explorador de Proyectos";
    Layout = "~/Views/Shared/_AzureLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.css" />
    <link rel="stylesheet" href="~/css/azureMap.css" />
}

<!--MAIN BANNER-->
<section class="banner-main">
    <div class="container">
        <!-- Begin bread crumbs -->
        <nav class="bread-crumbs">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <ul class="bread-crumbs-list">
                            <li>
                                <a href="/">Inicio</a>
                                <i class="material-icons md-18">chevron_right</i>
                            </li>
                            <li><a href="#!">Inversión Pública</a><i class="material-icons md-18">chevron_right</i></li>
                            <li>Mapa de inversiones públicas</li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav><!-- End bread crumbs -->

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="banner-main-info">
                    <div class="banner-main-title mb-0">
                        <h1>Mapa de inversiones públicas</h1>
                    </div>
                    <div class="banner-main-desc">
                        <p>Explora los proyectos de inversión pública en tu comuna o corregimiento. <br><span class="text-bold">Usa los filtros para acceder directamente a los proyectos de tu interés.</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="site-wrap">
        <div class="explorer">

            <!-- Fila principal (70% de la altura) -->
            <div class="explorer-row">

                <!-- Panel de filtros con contador de resultados -->
                <aside id="filtersPanel" class="filters" aria-label="Filtros">
                    <div class="hdr">
                        <h2>Filtros</h2>
                    </div>

                    <div id="filtersContainer" class="controls">
                        <!-- Se inyectan selects desde JS -->
                    </div>
                    <div class="proy-results">
                        <span id="resultsBadge" class="results-badge">0 proyectos</span>
                    </div>
                    <div class="actions">
                        <button id="clearBtn" type="button" class="btn btn-outlined">Limpiar</button>
                    </div>
                </aside>

                <!-- Mapa -->
                <main class="map-viewport" role="application" aria-label="Visor geográfico">
                    <div id="map" style="height:100%;width:100%;"></div>
                </main>
            </div>

            <!-- Lista de proyectos (debajo del mapa) -->
            <section class="results" aria-label="Listado de proyectos">
                <div class="results-header">
                    <h2>Listado de proyectos</h2>
                    <div id="investmentSummary" class="investment-summary" style="display:none"></div>
                </div>
                <div id="resultsList" class="results-list" aria-live="polite">
                    <!-- Tarjetas se inyectan -->
                </div>
                <nav id="pager" class="pager" aria-label="Paginación">
                    <!-- Botones numerados / Prev / Next -->
                </nav>
            </section>

        </div>
    </div>
</section>

@section Scripts {
    <!-- Azure Maps SDK -->
    <script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.js"></script>

    <!-- Subscription key inyectada desde appsettings.json → AzureMaps:SubscriptionKey -->
    <script>
        window.MAP_KEY = "@Configuration["AzureMaps:SubscriptionKey"]";
    </script>

    <script src="~/content/dist/js/main_azuremaps.js"></script>
}
